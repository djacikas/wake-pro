<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WakePro.Views.HomePage"
             Title="HomePage">
   <VerticalStackLayout>
      <Label 
            Text="Learn Wake Tricks!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
      <Label 
            Text="Choose group:"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
      <Button 
            Text="Basic"
            Command="{Binding NavigateToBasicTricksCommand}" />
      <Button 
            Text="Intermediate"
            Command="{Binding NavigateToIntermediateTricksCommand}" />  
      <Button 
            Text="Advanced"
            Command="{Binding NavigateToAdvancedTricksCommand}" />
   </VerticalStackLayout>
</ContentPage>